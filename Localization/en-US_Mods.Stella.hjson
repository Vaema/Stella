Configs: {
	Config: {
		DisplayName: Config

		MaxParticles: {
			Label: Max Particles
			Tooltip: Changes the maximum number of particles that can exist at once.
		}

		ScreenshakeModifier: {
			Label: Screen Shake Modifier
			Tooltip: Modifies the strength of screen shake effects. Set to zero to disable screen shake effects entirely.
		}
	}
}
