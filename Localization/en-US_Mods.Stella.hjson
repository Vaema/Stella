Configs: {
	StellaClientConfig: {
		DisplayName: Client Configuration

		MaxParticles: {
			Label: Max Particles
			Tooltip: Changes the maximum number of particles that can exist at once.
		}

		ScreenShakeModifier: {
			Label: Screen Shake Modifier
			Tooltip: Modifies the strength of screen shake effects. Set to zero to disable screen shake effects entirely.
		}
	}

	StellaServerConfig: {
		DisplayName: Server Configuration

		BehaviorOverrides: {
			Label: Behavior Overrides
			Tooltip: Overrides entity behaviors from other mods that depend on Stella. Disable if you want vanilla entity behaviors.
		}
	}
}
